# Copy to .env if you need to override a default. Nothing here is a secret:
# this is Create React App, so any REACT_APP_* value is substituted into the
# bundle and readable by anyone who loads the site.

# Origin used for canonical URLs and the sitemap at build time. Netlify sets
# this in production; the default is correct for local work.
# SITE_ORIGIN=https://docs.biofred.us
